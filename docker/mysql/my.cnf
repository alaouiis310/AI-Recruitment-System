# ---------------------------------------------------------------------------
# AI Recruitment System — configuration MySQL
# Objectif principal : garantir le support complet de l'UTF-8 (accents
# français dans les libellés, emojis éventuels dans les lettres de motivation).
# ---------------------------------------------------------------------------

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Authentification compatible avec le driver PDO de PHP 8.3
default-authentication-plugin = mysql_native_password

# Journalisation des requêtes lentes (utile pour justifier les index du MLD)
slow_query_log       = 1
long_query_time      = 2

[client]
default-character-set = utf8mb4

# ---------------------------------------------------------------------------
# AI Recruitment System — variables d'environnement Docker (racine du dépôt)
# Copier ce fichier en ".env" puis adapter si nécessaire.
# Ce fichier configure UNIQUEMENT docker-compose.
# La configuration de Laravel se trouve dans backend/.env
# ---------------------------------------------------------------------------

# UID/GID de votre utilisateur (Linux/macOS : exécuter `id -u` et `id -g`)
# Sous Windows/WSL2, laisser 1000.
UID=
GID=

# --- Ports exposés sur la machine hôte -------------------------------------
APP_PORT=
PMA_PORT=
MAIL_UI_PORT=
DB_PORT=

# --- Base de données -------------------------------------------------------
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

                "connexion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@airs.ma\",\n  \"password\": \"Password123\",\n  \"device_name\": \"postman\"\n}"
            },
            "description": "Enregistre le jeton dans la variable d'environnement token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Un jeton est retourne\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"token\");",
                  "});",
                  "// Le jeton alimente la variable utilisee par les requetes suivantes.",
                  "pm.environment.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },

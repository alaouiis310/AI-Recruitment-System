{
  "info": {
    "name": "AIRS — Systeme de Recrutement Intelligent",
    "description": "Collection de l'API backend du Systeme de Recrutement Intelligent.\n\nOrdre d'utilisation : lancer une requete de connexion du dossier Authentification — le jeton est enregistre automatiquement dans la variable d'environnement `token` — puis parcourir les dossiers Entreprises et Departements.\n\nCertaines requetes attendent un role precis : leur description indique avec quel compte les rejouer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Sante du service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
